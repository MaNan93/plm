QWidget {
    background-color: $bg_main;
    color: $text_main;
    font-family: $font_family;
    font-size: $font_size_body;
    font-weight: normal;
}
QWidget:disabled { color: $text_muted; }
QLabel { background: transparent; }
QMainWindow { background-color: $bg_sidebar; }
QWidget#WindowShell {
    background-color: $bg_sidebar;
    border: 1px solid $border;
    border-radius: 4px;
}
QWidget#WindowShell[maximized="true"] {
    background-color: $bg_sidebar;
    border: none;
    border-radius: 0;
}
QWidget#BodyContainer, QStackedWidget#ViewStack,
QWidget#MainContainer, QSplitter#ContentSplitter {
    background-color: $bg_sidebar;
    border: none;
}
QWidget#WindowResizeHandle {
    background: transparent;
    border: none;
}
QFrame#WindowTitleBar {
    background-color: $bg_sidebar;
    border: none;
}
QFrame#WindowTitleBar[windowActive="false"] {
    background-color: $bg_sidebar_inactive;
}
QLabel#WindowBrandLogo { background: transparent; }
QLabel#WindowBrandName {
    color: $text_main;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}
QPushButton#WindowControlButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 38px;
    max-height: 38px;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
}
QPushButton#WindowControlButton[role="minimize"]:hover,
QPushButton#WindowControlButton[role="maximize"]:hover {
    background-color: rgba(148, 163, 184, 28);
}
QPushButton#WindowControlButton[role="close"]:hover {
    background-color: #EF4444;
    color: $bg_surface;
}

QPushButton {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $spacing_sm $spacing_lg;
    color: $text_main;
    font-size: $font_size_body;
}
QPushButton:hover {
    background-color: $bg_subtle;
    border-color: $border_hover;
}
QPushButton:pressed { background-color: $border; }
QPushButton:disabled {
    background-color: $bg_subtle;
    color: $text_muted;
    border-color: $border;
}
QPushButton#PrimaryBtn, QPushButton#SettingsPrimaryButton,
QPushButton#ConfigGenerateButton {
    background-color: $primary;
    border: none;
    color: $bg_surface;
}
QPushButton#PrimaryBtn:hover, QPushButton#SettingsPrimaryButton:hover,
QPushButton#ConfigGenerateButton:hover {
    background-color: $primary_hover;
}
QPushButton#SettingsSecondaryButton, QPushButton#SettingsBrowseButton {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_control;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $spacing_sm $spacing_md;
    color: $text_main;
    font-size: $font_size_body;
    selection-background-color: $primary_light;
    selection-color: $text_main;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: $border_hover; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid $border_focus; }
QComboBox::drop-down { border: none; width: 32px; }
QComboBox QAbstractItemView {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    selection-background-color: $primary_light;
    selection-color: $text_main;
    outline: none;
    padding: $spacing_xs;
}

QFrame#Card, QWidget#Card, QFrame#HoverCardSurface {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_card;
}
QFrame#ProjectHoverCard { background: transparent; border: none; }

QTableWidget {
    background-color: $bg_surface;
    alternate-background-color: $bg_surface;
    border: none;
    gridline-color: $bg_subtle;
    color: $text_main;
    font-size: $font_size_body;
    outline: none;
}
QTableWidget::item {
    padding: $spacing_sm $spacing_md;
    border: none;
    border-bottom: 1px solid $bg_subtle;
}
QTableWidget::item:selected {
    background-color: $primary_light;
    color: $text_main;
}
QHeaderView::section {
    background-color: $bg_subtle;
    border: none;
    border-bottom: 1px solid $border;
    padding: $spacing_sm $spacing_md;
    font-weight: 600;
    color: $text_header;
}
QTableCornerButton::section { background-color: $bg_subtle; border: none; }

QMenu {
    min-width: 180px;
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_card;
    padding: 6px;
    margin: 4px;
}
QMenu::item {
    min-height: 28px;
    padding: $spacing_sm $spacing_lg;
    border-radius: $radius_chip;
    color: $text_main;
}
QMenu::item:selected {
    background-color: $primary_light;
    color: $primary;
}
QMenu::item:disabled { color: $text_muted; }
QMenu::separator {
    height: 1px;
    background-color: $border;
    margin: $spacing_xs $spacing_sm;
}

QTabWidget::pane { border: none; background: transparent; }
QTabWidget#ConfigTabs QTabBar {
    background-color: $bg_subtle;
    border-radius: $radius_control;
    padding: 3px;
}
QTabWidget#ConfigTabs QTabBar::tab {
    background: transparent;
    color: $text_sub;
    padding: 6px 16px;
    border: none;
    border-radius: $radius_chip;
    font-size: 13px;
    font-weight: 500;
}
QTabWidget#ConfigTabs QTabBar::tab:selected {
    background-color: $bg_surface;
    color: $text_main;
    font-weight: 600;
}
QTabWidget#ConfigTabs QTabBar::tab:hover:!selected {
    background-color: rgba(203, 213, 225, 72);
    color: $text_main;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: $border_hover;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: $text_muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: $border_hover;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: $text_muted; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QSplitter::handle { background-color: transparent; }
QSplitter::handle:vertical { height: 1px; }

QFrame#NavPanel {
    background-color: $bg_sidebar;
    border: none;
}
QFrame#NavPanel[windowActive="false"] {
    background-color: $bg_sidebar_inactive;
}
QFrame#NavPanel > QWidget, QWidget#NavRow, QWidget#ProjectItem,
QListWidget#ProjectList > QWidget { background: transparent; }
QLabel#ProjectSectionTitle {
    color: $text_muted;
    font-size: $font_size_sm;
    font-weight: bold;
    padding: $spacing_xs 7px;
}
QListWidget#ProjectList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}
QListWidget#ProjectList::item { background: transparent; border: none; padding: 0; }
QPushButton#NavActionButton, QPushButton#NavFooterButton,
QPushButton#ProjectButton {
    min-height: 36px;
    max-height: 36px;
    background: transparent;
    border: none;
    border-radius: $radius_control;
    color: $text_main;
    text-align: left;
}
QPushButton#NavActionButton, QPushButton#NavFooterButton { padding: 0 7px; }
QPushButton#ProjectButton { padding: 0 $spacing_md; }
QPushButton#NavActionButton:hover, QPushButton#NavFooterButton:hover,
QPushButton#ProjectButton:hover,
QPushButton#NavCollapseButton:hover, QPushButton#ProjectArchiveBtn:hover,
QPushButton#ProjectMoreBtn:hover {
    background-color: $bg_subtle;
    border: none;
}
QPushButton#ProjectButton[selected="true"], QPushButton#NavFooterButton[selected="true"] {
    background-color: $primary_light;
    color: $primary;
    font-weight: bold;
}
QLabel#ProjectName { color: $text_main; font-size: $font_size_body; }
QLabel#ProjectName[selected="true"] { color: $primary; font-weight: bold; }
QLineEdit#ProjectNameEditor { padding: 2px 4px; }
QPushButton#NavCollapseButton {
    min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px;
    background: transparent; border: none; border-radius: $radius_control; padding: 0;
}
QPushButton#ProjectArchiveBtn, QPushButton#ProjectMoreBtn {
    min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px;
    background: transparent; border: none; border-radius: $radius_chip; padding: 0;
}
QLabel#HoverProjectName { color: $text_main; font-size: $font_size_body; font-weight: bold; }
QLabel#HoverProjectPath { color: $text_sub; font-size: $font_size_sm; }
QFrame#HoverCardDivider { background-color: $border; border: none; }
QPushButton#HoverPinButton, QPushButton#HoverOpenButton {
    background: transparent; border: none; border-radius: $radius_chip; padding: 0;
}
QPushButton#HoverPinButton:hover, QPushButton#HoverOpenButton:hover { background: $bg_subtle; }

QFrame#ConfigPage {
    background-color: $bg_main;
    border: 1px solid $border;
    border-radius: 0;
    border-top-left-radius: 12px;
}
QFrame#ConfigHeader {
    background-color: $bg_surface;
    border: none;
    border-bottom: 1px solid $border;
    border-radius: 0;
    border-top-left-radius: 11px;
}
QLabel#ConfigSessionTitle {
    color: $text_main;
    font-size: $font_size_lg;
    font-weight: bold;
}
QLineEdit#ConfigSessionEditor {
    min-height: 24px;
    max-height: 24px;
    padding: 2px 8px;
}
QPushButton#HeaderButton, QPushButton#ArtifactsToolButton,
QPushButton#LogClearButton, QPushButton#LogCloseBtn,
QPushButton#SecondaryBackButton {
    background: transparent;
    border: none;
    border-radius: $radius_control;
    padding: 0;
}
QPushButton#HeaderButton:hover, QPushButton#ArtifactsToolButton:hover,
QPushButton#LogClearButton:hover, QPushButton#LogCloseBtn:hover,
QPushButton#SecondaryBackButton:hover { background-color: $bg_subtle; }
QPushButton#HeaderButton { border-radius: 0; }
QPushButton#ArtifactsToolButton:checked { background-color: $primary_light; }
QPushButton#ArtifactsToolButton::menu-indicator { image: none; width: 0; height: 0; }
QWidget#ConfigArea, QScrollArea#ConfigScroll, QWidget#ConfigScrollContent { background: $bg_main; border: none; }
QTabWidget#ConfigTabs::pane { border: none; background: transparent; }
QWidget#ConfigTabPage { background: transparent; border: none; }
QTableWidget#ConfigDataTable {
    background-color: transparent;
    alternate-background-color: transparent;
}
QTableWidget#ConfigDataTable::item { background-color: $bg_surface; }
QTableWidget#laneGrid { background-color: transparent; }

QFrame#ArtifactsPanel {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_card;
}
QWidget#ArtifactsToolbar, QWidget#ArtifactSearchBar { background: transparent; }
QPlainTextEdit#ArtifactCodePreview {
    background-color: $bg_surface;
    color: $text_main;
    border: none;
    border-radius: $radius_control;
    selection-background-color: $primary_light;
    selection-color: $text_main;
    font-family: $font_mono;
    font-size: $font_size_sm;
}
QPlainTextEdit#ArtifactCodePreview QScrollBar:horizontal { height: 4px; }
QPlainTextEdit#ArtifactCodePreview QScrollBar::handle:horizontal {
    min-width: 24px;
    border-radius: 2px;
}
QTreeWidget#ArtifactFileTree {
    background-color: $bg_surface;
    color: $text_main;
    border: 1px solid $border;
    border-radius: $radius_control;
    outline: none;
    padding: $spacing_xs;
}
QTreeWidget#ArtifactFileTree::item { min-height: 28px; border-radius: $radius_chip; }
QTreeWidget#ArtifactFileTree::item:selected { background: $primary_light; color: $primary; }
QLabel#ArtifactEmptyText {
    color: $text_muted;
    font-size: $font_size_body;
}

QFrame#LogPanel {
    background-color: $bg_surface;
    border: none;
    border-top: 1px solid $border;
    border-radius: 0;
}
QFrame#LogHeader { background: transparent; border: none; }
QLabel#LogTabTitle { color: $text_main; font-size: $font_size_body; font-weight: bold; }
QPlainTextEdit#LogOutput {
    background-color: $bg_surface;
    color: $text_main;
    border: none;
    padding: $spacing_sm $spacing_lg;
    font-family: $font_mono;
    font-size: $font_size_sm;
}
QFrame#LogStatusBar {
    background: $bg_subtle;
    border: none;
    border-top: 1px solid $border;
}
QLabel#LogStatusText { color: $text_sub; font-size: $font_size_sm; }

QLabel#GenerationStatus, QLabel#ArtifactStatus {
    background-color: $bg_subtle;
    color: $text_sub;
    border: none;
    border-radius: 10px;
    padding: 3px 8px;
    font-size: $font_size_sm;
}
QLabel#GenerationStatus[state="up_to_date"],
QLabel#ArtifactStatus[state="up_to_date"] {
    background-color: #DCFCE7;
    color: #15803D;
}
QLabel#GenerationStatus[state="out_of_date"], QLabel#ArtifactStatus[state="out_of_date"],
QLabel#GenerationStatus[state="external_changed"],
QLabel#ArtifactStatus[state="external_changed"] {
    background-color: #FEF3C7;
    color: #B45309;
}
QLabel#GenerationStatus[state="generating"],
QLabel#ArtifactStatus[state="generating"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
}
QLabel#GenerationStatus[state="failed"], QLabel#ArtifactStatus[state="failed"],
QLabel#GenerationStatus[state="invalid"],
QLabel#ArtifactStatus[state="invalid"] {
    background-color: #FEE2E2;
    color: #B91C1C;
}

QFrame#SecondaryPage, QWidget#SecondaryPageArea { background-color: $bg_main; }
QFrame#SecondaryPageHeader {
    background-color: $bg_surface;
    border: none;
    border-bottom: 1px solid $border;
}
QLabel#SecondaryPageTitle {
    color: $text_main;
    font-size: $font_size_lg;
    font-weight: bold;
}
QWidget#SecondaryPagePanel, QWidget#SecondaryContent, QWidget#SecondaryTabs { background: transparent; }
QFrame#SecondaryTabDivider { background-color: $border; border: none; }
QPushButton#SecondaryMenuButton {
    min-height: 36px; max-height: 36px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: $text_sub;
    font-size: $font_size_body;
    padding: 0 $spacing_md;
}
QPushButton#SecondaryMenuButton:hover { background: transparent; color: $text_main; }
QPushButton#SecondaryMenuButton[selected="true"] {
    background: transparent;
    color: $primary;
    border-bottom: 2px solid $primary;
    font-weight: bold;
}
QTextBrowser#DocumentationBrowser {
    background-color: $bg_surface;
    color: $text_main;
    border: 1px solid $border;
    border-radius: $radius_card;
    padding: $spacing_xs;
}
QFrame#SettingsRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid $border;
}
QLabel#SettingsRowLabel { color: $text_main; font-size: $font_size_body; }
QLabel#SettingsStatus { color: $text_sub; font-size: $font_size_sm; }
QLineEdit#SettingsEditorPath { padding: 4px $spacing_md; }

QDialog { background-color: $bg_main; color: $text_main; }
QMessageBox { background-color: $bg_surface; color: $text_main; }
QMessageBox QLabel { background: transparent; color: $text_main; }
QLabel#NewProjectDialogTitle {
    color: $text_main;
    font-size: $font_size_lg;
    font-weight: bold;
}
QLabel#NewProjectDialogSubtitle {
    color: $text_sub;
    font-size: $font_size_body;
}
QDialogButtonBox { background: transparent; }
QToolTip {
    background-color: $text_main;
    color: $bg_surface;
    border: none;
    border-radius: $radius_chip;
    padding: $spacing_xs $spacing_sm;
    font-size: $font_size_sm;
}

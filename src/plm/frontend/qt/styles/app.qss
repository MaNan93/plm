QWidget {
    background-color: $bg_main;
    color: $text_main;
    font-family: $font_family;
    font-size: $font_size_body;
    font-weight: $font_weight_normal;
}
QWidget:disabled { color: $text_muted; }
QFrame#ToastNotification {
    background-color: $success_bg;
    border: 1px solid $success_text;
    border-radius: $radius_control;
}
QFrame#ToastNotification QLabel { color: $success_text; }
QFrame#ToastNotification[level="info"] { background-color: $info_bg; border-color: $info_text; }
QFrame#ToastNotification[level="info"] QLabel { color: $info_text; }
QLabel { background: transparent; }
QMainWindow { background-color: transparent; }
QWidget#WindowBackdrop {
    background-color: transparent;
    border: none;
}
QWidget#WindowShell {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QWidget#WindowShell[maximized="true"] {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QWidget#BodyContainer, QStackedWidget#ViewStack,
QWidget#MainContainer, QSplitter#ContentSplitter {
    background-color: transparent;
    border: none;
}
QWidget#WindowResizeHandle {
    background: transparent;
    border: none;
}
QFrame#WindowTitleBar {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QLabel#WindowBrandLogo { background: transparent; }
QLabel#WindowBrandName {
    color: $text_main;
    font-size: $font_size_body;
    font-weight: $font_weight_semibold;
    background: transparent;
}
QPushButton#WindowControlButton {
    min-width: $titlebar_button_width;
    max-width: $titlebar_button_width;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
}
QPushButton#WindowControlButton[role="minimize"]:hover,
QPushButton#WindowControlButton[role="maximize"]:hover {
    background-color: $bg_hover;
}
QPushButton#WindowControlButton[role="close"]:hover {
    background-color: $danger;
    color: $text_on_primary;
}
QPushButton#WindowControlButton[role="close"] {
    border-top-right-radius: $radius_card;
}
QWidget#WindowShell[maximized="true"] QPushButton#WindowControlButton[role="close"] {
    border-top-right-radius: 0;
}

QPushButton {
    background-color: $bg_subtle;
    border: none;
    border-radius: $radius_hover;
    padding: $control_padding_y $control_padding_x;
    color: $text_main;
    font-size: $font_size_body;
}
QPushButton:hover {
    background-color: $bg_hover;
    border-color: $border_hover;
}
QPushButton:pressed { background-color: $border; }
QPushButton:disabled {
    background-color: $bg_subtle;
    color: $text_muted;
    border-color: $border;
}
QPushButton#PrimaryBtn, QPushButton#SettingsPrimaryButton,
QPushButton#ConfigGenerateButton {
    background-color: $primary;
    border: none;
    color: $text_on_primary;
}
/* The ID rule above outranks QPushButton:disabled; without this a disabled
   Generate button (no project, or generating) still looks clickable. */
QPushButton#PrimaryBtn:disabled, QPushButton#SettingsPrimaryButton:disabled,
QPushButton#ConfigGenerateButton:disabled {
    background-color: $bg_subtle;
    color: $text_muted;
}
QPushButton#PrimaryBtn:hover:enabled, QPushButton#SettingsPrimaryButton:hover:enabled,
QPushButton#ConfigGenerateButton:hover:enabled {
    background-color: $primary_hover;
}
QPushButton#PrimaryBtn:pressed:enabled, QPushButton#SettingsPrimaryButton:pressed:enabled,
QPushButton#ConfigGenerateButton:pressed:enabled { background-color: $primary_active; }
QPushButton#SettingsSecondaryButton, QPushButton#SettingsBrowseButton {
    background-color: $bg_subtle;
    border: none;
    border-radius: $radius_hover;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: $bg_subtle;
    border: 1px solid transparent;
    border-radius: $radius_control;
    padding: $field_padding_y $control_padding_x;
    color: $text_main;
    font-size: $font_size_body;
    selection-background-color: $primary_soft;
    selection-color: $text_main;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: $border_hover; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid $border_focus; }
QLineEdit QToolButton, QLineEdit QToolButton:hover {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}
QCheckBox {
    spacing: $spacing_sm;
    color: $text_main;
    font-size: $font_size_body;
    background: transparent;
}
QCheckBox::indicator {
    width: $checkbox_indicator_content_size;
    height: $checkbox_indicator_content_size;
    border: $checkbox_border_width solid $border_checkbox;
    border-radius: $radius_chip;
    background-color: $bg_subtle;
}
QCheckBox::indicator:hover {
    border-color: $border_focus;
    background-color: $bg_hover;
}
QCheckBox::indicator:checked {
    background-color: $primary;
    border-color: $primary;
    image: url("$checkmark_icon");
}
QCheckBox::indicator:checked:hover {
    background-color: $primary_hover;
    border-color: $primary_hover;
}
QCheckBox:disabled { color: $text_muted; }
QCheckBox::indicator:disabled {
    border-color: $border;
    background-color: $bg_main;
}
QCheckBox::indicator:checked:disabled {
    border-color: $border;
    background-color: $bg_subtle;
    image: url("$checkmark_disabled_icon");
}
QComboBox::drop-down { border: none; width: 32px; }
QComboBox::down-arrow {
    image: url("$chevron_down_icon");
    width: $icon_glyph_size;
    height: $icon_glyph_size;
}
QComboBox QAbstractItemView {
    background-color: $bg_surface;
    border: none;
    border-radius: $radius_card;
    selection-background-color: $primary_soft;
    selection-color: $text_main;
    outline: none;
    padding: $menu_padding;
}
QComboBox QAbstractItemView::item {
    height: $control_height;
    padding: 0 $menu_item_padding_x;
    margin: 0;
    border: none;
    border-radius: $radius_hover;
}

QTableWidget {
    background-color: $bg_surface;
    alternate-background-color: $bg_alternate;
    border: none;
    gridline-color: $border;
    color: $text_main;
    font-size: $font_size_body;
    outline: none;
}
QTableWidget::item {
    padding: $control_padding_y $control_padding_x;
    border: none;
}
QTableWidget::item:selected {
    background-color: $primary_soft;
    color: $text_main;
}
QHeaderView::section {
    background-color: $bg_subtle;
    border: none;
    padding: $control_padding_y $control_padding_x;
    font-weight: $font_weight_medium;
    color: $text_header;
}
QTableCornerButton::section { background-color: $bg_subtle; border: none; }

QMenu {
    min-width: $menu_min_width;
    background-color: $bg_surface;
    border: none;
    border-radius: $menu_radius;
    padding: $menu_padding;
    margin: 0;
    font-family: $font_family;
}
QMenu::item {
    height: $control_height;
    padding: 0 $menu_item_padding_x;
    margin: 0 0 $menu_gap 0;
    border: none;
    border-radius: $radius_hover;
    background: transparent;
    color: $text_main;
}
/* Transparent gutters leave room for StyledMenu's painted soft shadow. */
StyledMenu {
    background: transparent;
    padding: $menu_outer_padding $menu_outer_padding $menu_bottom_padding $menu_outer_padding;
}
QMenu::item:selected {
    background-color: $bg_subtle;
    color: $text_main;
}
QMenu::item:disabled { color: $text_muted; }
QMenu::separator {
    height: 0;
    background: transparent;
    margin: 0;
    padding: 0;
}

QTabWidget::pane { border: none; background: transparent; }
QTabWidget#ConfigTabs::tab-bar { left: $spacing_lg; }
QTabWidget#ConfigTabs QTabBar {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: $border_hover;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: $text_muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: $border_hover;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: $text_muted; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QSplitter::handle { background-color: transparent; }
QSplitter::handle:vertical { height: 1px; }
QSplitter#ContentSplitter::handle:vertical { height: $splitter_handle_size; background: transparent; margin: 0; }

QFrame#NavPanel {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QFrame#NavPanel > QWidget, QWidget#NavRow, QWidget#ProjectItem,
QListWidget#ProjectList > QWidget { background: transparent; }
QFrame#NavPanel QFrame#ProjectSectionSeparator {
    background-color: $border_hover;
    border: none;
    margin-left: 4px;
    margin-right: 4px;
}
QListWidget#ProjectList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}
QListWidget#ProjectList::item { background: transparent; border: none; padding: 0; }
QPushButton#NavActionButton, QPushButton#NavFooterButton,
QPushButton#ProjectButton {
    background: transparent;
    border: none;
    border-radius: $radius_hover;
    color: $text_main;
    text-align: left;
}
QPushButton#NavActionButton, QPushButton#NavFooterButton {
    padding: $control_padding_y $control_padding_x $control_padding_y $nav_icon_inset;
}
QPushButton#ProjectButton { padding: 0; }
QPushButton#NavActionButton:hover, QPushButton#NavFooterButton:hover,
QPushButton#ProjectButton:hover,
QPushButton#NavCollapseButton:hover,
QPushButton#ProjectMoreBtn:hover {
    background-color: $bg_subtle;
    border: none;
}
QPushButton#NavActionButton:hover, QPushButton#NavActionButton:focus,
QPushButton#NavFooterButton:hover, QPushButton#NavFooterButton:focus,
QPushButton#ProjectButton:hover, QPushButton#ProjectButton:focus,
QPushButton#ProjectMoreBtn:hover, QPushButton#ProjectMoreBtn:focus {
    background-color: $bg_subtle;
}
QPushButton#NavActionButton:pressed, QPushButton#NavFooterButton:pressed,
QPushButton#ProjectButton:pressed, QPushButton#ProjectMoreBtn:pressed {
    background-color: $border_hover;
}
QPushButton#ProjectButton[menuOpen="true"] { background-color: $bg_subtle; }
QPushButton#ProjectButton[selected="true"], QPushButton#NavFooterButton[selected="true"] {
    background-color: $primary_soft;
    color: $text_main;
    font-weight: $font_weight_medium;
}
QLabel#ProjectName { color: $text_main; font-size: $font_size_body; }
QLabel#ProjectName[selected="true"] { color: $text_main; font-weight: $font_weight_medium; }
QLineEdit#ProjectNameEditor {
    padding: 0;
    margin: 0;
    border: 1px solid $primary;
    border-radius: $radius_control;
    font-size: $font_size_body;
}
QPushButton#NavCollapseButton {
    min-width: $icon_button_size; max-width: $icon_button_size;
    background: transparent; border: none; border-radius: $radius_control; padding: 0;
}
QPushButton#ProjectMoreBtn {
    min-width: 28px; max-width: 28px;
    background: transparent; border: none; border-radius: $radius_hover; padding: 0;
}
QFrame#ConfigPage {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QFrame#ConfigHeader {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QLabel#ConfigSessionTitle {
    color: $text_main;
    font-size: $font_size_title;
    font-weight: $font_weight_semibold;
}
QLineEdit#ConfigSessionEditor {
    padding: 0;
    margin: 0;
    border: 1px solid $primary;
    border-radius: $radius_control;
    font-size: $font_size_title;
    font-weight: $font_weight_semibold;
}
QPushButton#HeaderButton, QPushButton#ArtifactsToolButton,
QPushButton#LogClearButton, QPushButton#LogCloseBtn,
QPushButton#SecondaryBackButton {
    background: transparent;
    border: none;
    border-radius: $radius_control;
    padding: 0;
}
QPushButton#ArtifactsToolButton:hover,
QPushButton#LogClearButton:hover, QPushButton#LogCloseBtn:hover { background-color: $bg_subtle; }
/* These sit on the chrome, not on a panel. */
QPushButton#HeaderButton:hover, QPushButton#SecondaryBackButton:hover,
QPushButton#HeaderButton:focus { background-color: $bg_sidebar_hover; }
QPushButton#HeaderButton:pressed { background-color: $border; }
QPushButton#ArtifactsToolButton:checked { background-color: $primary_soft; }
QPushButton#ArtifactsToolButton::menu-indicator { image: none; width: 0; height: 0; }
QWidget#ConfigArea, QScrollArea#ConfigScroll, QWidget#ConfigScrollContent { background: $bg_main; border: none; }
QWidget#ConfigTabPage { background: transparent; border: none; }
QTableWidget#ConfigDataTable {
    background-color: $bg_surface;
    alternate-background-color: $bg_alternate;
    selection-background-color: $primary_soft;
    selection-color: $text_main;
}
QTableWidget#ConfigDataTable::item { background-color: $bg_surface; }
QTableWidget#ConfigDataTable::item:alternate { background-color: $bg_alternate; }
QTableWidget#ConfigDataTable::item:selected {
    background-color: $primary_soft;
    color: $text_main;
}
QTableWidget#ConfigDataTable::item:hover:!selected { background-color: $bg_subtle; }
QTableWidget#ConfigDataTable[formatterTable="true"]::item {
    padding: 0px 10px;
}
QWidget#ConfigCsvEditor { background-color: transparent; }
QWidget#ConfigCsvEditor QTableWidget {
    /* Header corners reveal the page directly, without an inset card. */
    background-color: transparent;
    alternate-background-color: $bg_alternate;
    border: none;
    gridline-color: $border;
}
QWidget#ConfigCsvEditor QHeaderView { background: transparent; }
QWidget#ConfigCsvEditor QHeaderView::section:first { border-top-left-radius: $radius_card; }
QWidget#ConfigCsvEditor QHeaderView::section:last { border-top-right-radius: $radius_card; }
QWidget#ConfigCsvEditor QHeaderView::section {
    border: none;
    border-bottom: 1px solid $border;
    border-right: 1px solid $border;
}
QWidget#ConfigCsvEditor QTableWidget::item { border-bottom: 1px solid $border; }
QLabel#ConfigSaveState {
    background-color: $success_bg;
    color: $success_text;
    border: none;
    border-radius: $radius_chip;
    padding: $status_padding_y $spacing_sm;
    font-size: $font_size_small;
}
QLabel#ConfigSaveState[dirty="true"] {
    background-color: $warning_bg;
    color: $warning_text;
}
QLabel#ProjectPath, QLabel#SettingsDescription, QLabel#TableFilterCount {
    color: $text_muted;
    font-size: $font_size_small;
    background: transparent;
}
QFrame#LogCollapsedBar {
    background-color: $bg_subtle;
    border: 1px solid $border;
    border-radius: $radius_control;
}
QPushButton#TableActionButton { padding: 0 10px; }
QGroupBox#FormCard {
    background-color: $bg_surface;
    border: 1px solid $border;
    border-radius: 8px;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    color: $text_main;
}
QGroupBox#FormCard::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: $text_main;
}
QGroupBox#FormCard QLabel { font-size: $font_size_body; font-weight: 400; }
QGroupBox#FormCard QLabel#SettingsDescription { font-size: 12px; }
QGroupBox#FormCard QCheckBox,
QGroupBox#FormCard QFrame#SettingsRow,
QGroupBox#FormCard QWidget#SettingsEditorControl { background: transparent; }
QTabBar#FormatterMode::tab {
    background: transparent;
    color: $text_sub;
    padding: 4px 12px;
    border-bottom: 2px solid transparent;
}
QTabBar#FormatterMode::tab:selected { color: $text_primary; border-bottom-color: $primary; }
QTableWidget#laneGrid {
    background-color: $bg_surface;
    selection-background-color: $primary_soft;
    selection-color: $text_main;
    border: none;
}

QFrame#ArtifactsPanel {
    background-color: $bg_artifacts;
    border: $artifacts_border_width solid $border_artifacts;
    border-radius: $radius_card;
}
QWidget#ArtifactSearchBar { background: transparent; }
QWidget#ArtifactsToolbar {
    background-color: $bg_artifacts_header;
    border: none;
    border-bottom: 1px solid $border_artifacts;
    border-top-left-radius: $radius_card;
    border-top-right-radius: $radius_card;
}
QLabel#ArtifactPath {
    color: $text_artifacts;
    background: transparent;
    border: none;
    font-size: $font_size_body;
    padding: 0 6px;
}
QPushButton#ArtifactsToolButton { border-radius: 6px; padding: 0; }
QPushButton#ArtifactsToolButton:hover { background-color: $border_artifacts; }
QWidget#ArtifactContent { background: transparent; border: none; }
QWidget#ArtifactEmptyState { background: transparent; }
QPushButton#ArtifactPathButton {
    background: transparent;
    border: none;
    border-radius: $radius_hover;
    padding: 0;
}
QPushButton#ArtifactPathButton:hover { background-color: $border_artifacts; }
QPushButton#ArtifactPathButton:checked { background-color: $primary_soft; }
QPushButton#ArtifactPathButton:focus { border: 1px solid $accent_artifacts; }
QFrame#ArtifactFilePopup {
    background: transparent;
    border: none;
    border-radius: $radius_card;
}
QPlainTextEdit#ArtifactCodePreview {
    background-color: $bg_artifacts;
    color: $text_artifacts;
    border: none;
    border-radius: 0;
    selection-background-color: $primary_soft;
    selection-color: $text_main;
    font-family: $font_mono;
    font-size: $font_size_body;
}
QPlainTextEdit#ArtifactCodePreview QScrollBar:horizontal { height: 4px; }
QPlainTextEdit#ArtifactCodePreview QScrollBar::handle:horizontal {
    min-width: 24px;
    border-radius: 2px;
}
QTreeWidget#ArtifactFileTree {
    background-color: $bg_surface;
    color: $text_main;
    border: none;
    border-radius: $radius_card;
    outline: none;
    padding: 8px;
    font-family: $font_family;
    font-size: $font_size_body;
    selection-background-color: $primary_soft;
    selection-color: $text_main;
}
QTreeWidget#ArtifactFileTree::item {
    height: $control_height;
    padding: 0 $menu_item_padding_x;
    border-radius: $radius_hover;
    color: $text_main;
    font-size: $font_size_body;
}
QTreeWidget#ArtifactFileTree::item:hover:!selected { background-color: $bg_hover; }
QTreeWidget#ArtifactFileTree::item:selected {
    background-color: $primary_soft;
    color: $text_main;
}
QTreeWidget#ArtifactFileTree::branch:selected { background: $bg_surface; }
QTreeWidget#ArtifactFileTree::branch:has-children:!has-siblings:closed,
QTreeWidget#ArtifactFileTree::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url("$chevron_right_icon");
    width: $icon_glyph_size;
    height: $icon_glyph_size;
}
QTreeWidget#ArtifactFileTree::branch:open:has-children:!has-siblings,
QTreeWidget#ArtifactFileTree::branch:open:has-children:has-siblings {
    border-image: none;
    image: url("$chevron_down_icon");
    width: $icon_glyph_size;
    height: $icon_glyph_size;
}
QTreeWidget#ArtifactFileTree QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px 4px 0;
}
QTreeWidget#ArtifactFileTree QScrollBar::handle:vertical {
    background: $border_hover;
    border-radius: 3px;
    min-height: 30px;
}
QTreeWidget#ArtifactFileTree QScrollBar::handle:vertical:hover { background: $text_muted; }
QTreeWidget#ArtifactFileTree QScrollBar::add-line:vertical,
QTreeWidget#ArtifactFileTree QScrollBar::sub-line:vertical { height: 0; }
QTreeWidget#ArtifactFileTree QScrollBar::add-page:vertical,
QTreeWidget#ArtifactFileTree QScrollBar::sub-page:vertical { background: transparent; }
QLabel#ArtifactEmptyText {
    color: $text_artifacts_muted;
    font-size: $font_size_body;
}

QFrame#LogPanel {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QFrame#LogHeader { background: transparent; border: none; }
QLabel#LogTabTitle { color: $text_main; font-size: $font_size_body; font-weight: $font_weight_semibold; }
QPlainTextEdit#LogOutput {
    background-color: $bg_surface;
    color: $text_main;
    border: none;
    padding: $spacing_sm $spacing_lg;
    font-family: $font_mono;
    font-size: $font_size_body;
}
QFrame#LogStatusBar {
    background: $bg_card;
    border: none;
}
QLabel#LogStatusText { color: $text_sub; font-size: $font_size_body; }

QLabel#ConfigErrorSummary {
    background-color: $danger_bg;
    color: $danger_text;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    margin: 8px 0 0 0;
    font-size: $font_size_body;
}
QLabel#GenerationStatus {
    background-color: $bg_subtle;
    color: $text_sub;
    border: none;
    border-radius: $radius_chip;
    padding: 3px 8px;
    font-size: $font_size_body;
}
QLabel#GenerationStatus[state="up_to_date"] {
    background-color: $success_bg;
    color: $success_text;
}
QLabel#GenerationStatus[state="out_of_date"],
QLabel#GenerationStatus[state="external_changed"] {
    background-color: $warning_bg;
    color: $warning_text;
}
QLabel#GenerationStatus[state="generating"] {
    background-color: $info_bg;
    color: $info_text;
}
QLabel#GenerationStatus[state="failed"],
QLabel#GenerationStatus[state="invalid"] {
    background-color: $danger_bg;
    color: $danger_text;
}

/* Settings and documentation sit in an outlined panel on the chrome, the
   same way the config and output panels do. */
QFrame#SecondaryPage { background-color: transparent; }
QWidget#SecondaryPageArea {
    background: transparent;
    border: none;
    margin: 0;
}
QFrame#SecondaryPageHeader {
    background: transparent;
    border: none;
}
QLabel#SecondaryPageTitle {
    color: $text_main;
    font-size: $font_size_body;
    font-weight: $font_weight_semibold;
}
QWidget#SecondaryPageBody, QWidget#SecondaryPagePanel,
QWidget#SecondaryContent, QWidget#SecondaryTabs { background: transparent; }
QFrame#SecondaryTabDivider { background: transparent; border: none; }
QPushButton#SecondaryMenuButton {
    background: transparent;
    border: none;
    border-radius: $radius_hover;
    color: $text_sub;
    font-size: $font_size_body;
    padding: 0 $spacing_md;
}
QPushButton#SecondaryMenuButton:hover { background-color: $bg_subtle; color: $text_main; }
QPushButton#SecondaryMenuButton[selected="true"] {
    background-color: $primary_soft;
    color: $text_primary;
    font-weight: $font_weight_medium;
}
QTextBrowser#DocumentationBrowser {
    background-color: $bg_surface;
    color: $text_main;
    border: none;
    border-radius: $radius_card;
    padding: $spacing_xs;
}
QFrame#SettingsRow {
    background: transparent;
    border: none;
    border-radius: $radius_control;
}
QWidget#SettingsEditorControl { background: transparent; border: none; }
QLabel#SettingsRowLabel { color: $text_main; font-size: $font_size_body; }
QLabel#SettingsStatus { color: $text_sub; font-size: $font_size_body; }
QLineEdit#SettingsEditorPath { padding: 0 $spacing_md; }

QDialog { background-color: $bg_main; color: $text_main; border: none; border-radius: 0; }
QMessageBox { background-color: $bg_surface; color: $text_main; border-radius: 0; }
QMessageBox QLabel { background: transparent; color: $text_main; }
QLabel#NewProjectDialogTitle {
    color: $text_main;
    font-size: $font_size_body;
    font-weight: $font_weight_semibold;
}
QLabel#NewProjectDialogSubtitle {
    color: $text_sub;
    font-size: $font_size_body;
}
QDialogButtonBox { background: transparent; }
/* Joined command buttons share borders and touch without gaps.
   Navigation tabs use SecondaryMenuButton instead of a ButtonGroup. */
QFrame#ButtonGroup { background: transparent; border: none; border-radius: 0; }
QFrame#ButtonGroup > QPushButton {
    background-color: $bg_subtle;
    padding: $control_padding_y $control_padding_x;
    margin: 0;
    border: none;
    border-right: none;
    border-radius: 0;
}
QFrame#ButtonGroup > QPushButton[groupFirst="true"] {
    border-top-left-radius: $radius_hover;
    border-bottom-left-radius: $radius_hover;
}
QFrame#ButtonGroup > QPushButton[groupLast="true"] {
    border-top-right-radius: $radius_hover;
    border-bottom-right-radius: $radius_hover;
}
QFrame#ButtonGroup > QPushButton:hover {
    background-color: $bg_subtle;
    border-color: $border_hover;
}
QFrame#ButtonGroup > QPushButton:pressed { background-color: $border; }
QPushButton#NavActionButton:hover, QPushButton#NavFooterButton:hover,
QPushButton#ProjectButton:hover {
    background-color: $bg_sidebar_hover;
}
QPushButton#ProjectButton[menuOpen="true"] { background-color: $bg_sidebar_hover; }
/* White on the tinted chrome: the selected row reads as raised, and stays
   clearly apart from hover. */
QPushButton#ProjectButton[selected="true"], QPushButton#NavFooterButton[selected="true"] {
    background-color: $bg_surface;
    color: $text_main;
}
QPushButton#NavActionButton:focus, QPushButton#NavFooterButton:focus,
QPushButton#ProjectButton:focus { background-color: $bg_sidebar_hover; }
QPushButton#NavActionButton:pressed, QPushButton#NavFooterButton:pressed,
QPushButton#ProjectButton:pressed { background-color: $border_hover; }
QPushButton#ProjectMoreBtn {
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    border-radius: $radius_hover;
}
QPushButton#ProjectMoreBtn:hover {
    background-color: $bg_hover;
}
QPushButton#ProjectMoreBtn:focus, QPushButton#ProjectMoreBtn:pressed,
QPushButton#ProjectMoreBtn[menuOpen="true"] {
    background-color: $border_hover;
}
QFrame#ButtonGroup > QPushButton[selected="true"] {
    background-color: $primary_soft;
    color: $text_primary;
    border-bottom: none;
}
QToolTip {
    background-color: $tooltip_bg;
    color: $tooltip_text;
    border: none;
    border-radius: $radius_card;
    padding: 6px 10px;
    font-size: $font_size_body;
}

/* Delegate editors keep the painted cell's text position. */
QWidget#ConfigCsvEditor QTableWidget QLineEdit {
    background-color: $bg_surface;
    border: 1px solid $primary;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

/* Embedded formatter values share the table row's continuous background. */
QTableWidget#ConfigDataTable[formatterTable="true"] QComboBox,
QTableWidget#ConfigDataTable[formatterTable="true"] QLineEdit {
    background: transparent;
    border: 1px solid $border_hover;
    border-radius: 6px;
    padding: 0 $spacing_md;
}
QWidget#FormatterValueCell { background: transparent; border: none; }
/* QLineEdit adds a native 2 px text inset; match the combo's label start. */
QTableWidget#ConfigDataTable[formatterTable="true"] QLineEdit { padding: 0 10px; }
QTableWidget#ConfigDataTable[formatterTable="true"] QComboBox:focus,
QTableWidget#ConfigDataTable[formatterTable="true"] QLineEdit:focus {
    border-color: $border_focus;
}
QPushButton#SecondaryBackButton {
    background-color: $bg_subtle;
    border-radius: $radius_hover;
    padding: $control_padding_y $control_padding_x;
    font-weight: $font_weight_medium;
}

/* Neutral button focus; selected controls keep their primary fill below. */
QPushButton:focus:!pressed,
QPushButton#PrimaryBtn:focus:!pressed,
QPushButton#SettingsPrimaryButton:focus:!pressed,
QPushButton#SettingsSecondaryButton:focus:!pressed,
QPushButton#SettingsBrowseButton:focus:!pressed,
QPushButton#ConfigGenerateButton:focus:!pressed,
QPushButton#NavActionButton:focus:!pressed,
QPushButton#NavFooterButton:focus:!pressed,
QPushButton#NavCollapseButton:focus:!pressed,
QPushButton#ProjectButton:focus:!pressed,
QPushButton#ProjectMoreBtn:focus:!pressed,
QPushButton#HeaderButton:focus:!pressed,
QPushButton#ArtifactsToolButton:focus:!pressed,
QPushButton#ArtifactPathButton:focus:!pressed,
QPushButton#LogClearButton:focus:!pressed,
QPushButton#LogCloseBtn:focus:!pressed,
QPushButton#SecondaryBackButton:focus:!pressed,
QPushButton#SecondaryMenuButton:focus:!pressed,
QPushButton#WindowControlButton:focus:!pressed,
QFrame#ButtonGroup > QPushButton:focus:!pressed {
    background-color: $bg_focus;
    color: $text_main;
    border: none;
}

/* Selection remains blue while a navigation control has focus or hover. */
QPushButton#ProjectButton[selected="true"],
QPushButton#ProjectButton[selected="true"]:hover,
QPushButton#ProjectButton[selected="true"]:focus:!pressed,
QPushButton#NavFooterButton[selected="true"],
QPushButton#NavFooterButton[selected="true"]:hover,
QPushButton#NavFooterButton[selected="true"]:focus:!pressed,
QPushButton#SecondaryMenuButton[selected="true"],
QPushButton#SecondaryMenuButton[selected="true"]:hover,
QPushButton#SecondaryMenuButton[selected="true"]:focus:!pressed,
QPushButton#ArtifactsToolButton:checked,
QPushButton#ArtifactsToolButton:checked:hover,
QPushButton#ArtifactsToolButton:checked:focus:!pressed,
QPushButton#ArtifactPathButton:checked,
QPushButton#ArtifactPathButton:checked:hover,
QPushButton#ArtifactPathButton:checked:focus:!pressed,
QFrame#ButtonGroup > QPushButton[selected="true"]:hover,
QFrame#ButtonGroup > QPushButton[selected="true"]:focus:!pressed,
QFrame#ButtonGroup > QPushButton[selected="true"] {
    background-color: $primary_soft;
}
QPushButton#ProjectButton[selected="true"]:pressed,
QPushButton#NavFooterButton[selected="true"]:pressed,
QPushButton#SecondaryMenuButton[selected="true"]:pressed,
QPushButton#ArtifactsToolButton:checked:pressed,
QPushButton#ArtifactPathButton:checked:pressed,
QFrame#ButtonGroup > QPushButton[selected="true"]:pressed {
    background-color: $primary_pressed;
}

/* Settings and configuration share the same underline navigation tokens. */
QTabWidget#ConfigTabs QTabBar::tab,
QPushButton#SecondaryMenuButton[underlineTab="true"] {
    background: transparent;
    color: $text_sub;
    padding: 0 $tab_padding_x;
    margin: 0;
    border: none;
    border-bottom: $tab_indicator_height solid transparent;
    border-radius: 0;
    font-size: $font_size_body;
    font-weight: $font_weight_medium;
}
QTabWidget#ConfigTabs QTabBar::tab:hover:!selected,
QPushButton#SecondaryMenuButton[underlineTab="true"]:hover,
QPushButton#SecondaryMenuButton[underlineTab="true"]:focus:!pressed {
    background-color: $bg_subtle;
    color: $text_main;
    border-bottom: $tab_indicator_height solid transparent;
}
QTabWidget#ConfigTabs QTabBar::tab:selected,
QPushButton#SecondaryMenuButton[underlineTab="true"][selected="true"],
QPushButton#SecondaryMenuButton[underlineTab="true"][selected="true"]:hover,
QPushButton#SecondaryMenuButton[underlineTab="true"][selected="true"]:focus,
QPushButton#SecondaryMenuButton[underlineTab="true"][selected="true"]:pressed {
    background-color: transparent;
    color: $text_primary;
    border-bottom: $tab_indicator_height solid $primary;
    font-weight: $font_weight_semibold;
}

QFrame#LogCollapsedBar QPushButton#LogCollapsedButton,
QFrame#LogCollapsedBar QPushButton#LogCollapsedButton:hover,
QFrame#LogCollapsedBar QPushButton#LogCollapsedButton:focus,
QFrame#LogCollapsedBar QPushButton#LogCollapsedButton:pressed {
    text-align: left;
    background: transparent;
    color: $text_sub;
    border: none;
    border-radius: 0;
    padding: 0 $control_padding_x;
}
QFrame#LogCollapsedBar QPushButton#LogCollapsedButton:hover,
QFrame#LogCollapsedBar QPushButton#LogCollapsedButton:focus {
    color: $text_main;
}
QFrame#LogCollapsedBar QPushButton#LogClearButton {
    background: transparent;
    border: none;
    border-radius: $radius_control;
}
QFrame#LogCollapsedBar QPushButton#LogClearButton:hover,
QFrame#LogCollapsedBar QPushButton#LogClearButton:focus {
    background-color: $bg_hover;
    color: $text_main;
}

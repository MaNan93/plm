  <property name="styleSheet"><string notr="true">QWidget { background:#faf9f6; color:#2b2926; font:13px "Segoe UI"; }
QFrame#sidebar { background:#f0eee6; border-right:1px solid #d6d0c0; }
QFrame#sidebar QLabel { background:transparent; }
QLabel#brandName { font-size:14px; font-weight:600; }
QLabel#sectionHeader { color:#9c9686; font-size:11px; font-weight:600; }
QPushButton#newWorkspaceButton, QPushButton#saveWorkspaceButton, QPushButton#openWorkspaceButton, QPushButton#settingsButton, QPushButton#documentationButton { text-align:left; padding-left:12px; border:1px solid #e5e1d6; border-radius:8px; background:#f5f4ef; }
QFrame#recentWorkspaceRow { background:#e4e0d3; border:none; border-radius:8px; }
QLabel#recentWorkspaceName { background:transparent; }
QToolButton#recentMenuBtn { background:transparent; border:none; border-radius:6px; color:#9c9686; font-size:16px; }
QToolButton#edgeToggle { background:#faf9f6; border:1px solid #e5e1d6; border-radius:8px; }
QFrame#editorShell { background:#f5f4ef; border:1px solid #e5e1d6; border-radius:12px; }
QTabWidget::pane { border:none; top:-1px; background:#faf9f6; }
QTabBar::tab { color:#6b6658; background:transparent; padding:8px 18px; margin:0 2px; border:1px solid transparent; border-radius:8px; font-weight:500; }
QTabBar::tab:selected { color:#2b2926; background:#faf9f6; border-color:#e5e1d6; font-weight:600; }
QTableWidget { background:#faf9f6; border:none; gridline-color:#e5e1d6; selection-background-color:#f2ded4; }
QTableWidget::item { padding-left:10px; }
QHeaderView::section { background:#f5f4ef; color:#6b6658; padding:7px 8px; border:none; border-bottom:1px solid #e5e1d6; font-size:11px; font-weight:600; }
QFrame#logCard { background:#faf9f6; border:1px solid #e5e1d6; border-radius:12px; }
QLabel#logTitle { background:transparent; font-weight:600; }
QPlainTextEdit#logConsole { background:transparent; border:none; color:#6b6658; font:12px Consolas; }
QToolButton#logMoreButton, QToolButton#logToggle, QToolButton#previewToggleButton { background:transparent; border:none; border-radius:7px; color:#6b6658; }
QToolButton#previewToggleButton { border:1px solid #e5e1d6; background:#f5f4ef; }
QScrollBar:vertical { width:14px; background:transparent; margin:2px; }
QScrollBar:horizontal { height:14px; background:transparent; margin:2px; }
QScrollBar::handle { background:#c9c9c9; border-radius:4px; min-width:28px; min-height:28px; }</string></property>

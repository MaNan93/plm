  <widget class="QPlainTextEdit" name="rtlPreviewCode"><property name="geometry"><rect><x>18</x><y>91</y><width>486</width><height>674</height></rect></property><property name="toolTip"><string>代码和 CSV 文本预览区 / rtlPreviewCode</string></property><property name="plainText"><string>//============================================================
// pipe_lane_clk_gate -- clock-gating wrapper
//
// When gating a clock, the enable must only toggle while the
// clock is low. The preview also supports config CSV files.
//============================================================
module pipe_lane_clk_gate (
    input  logic clk_in,
    input  logic en,
    input  logic test_en,
    output logic clk_out
);

logic en_latched;

always_latch begin
    if (!clk_in)
        en_latched = en | test_en;
end

assign clk_out = clk_in &amp; en_latched;
endmodule</string></property><property name="readOnly"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property></widget>
